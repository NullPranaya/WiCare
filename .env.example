# copy to .env (never commit .env)
AURACARE_DB=auracare.db
SENSOR_ID=esp32_01
DEMO_MODE=1                     # replay/synthetic may message TEST recipients only
PARTICIPANT_OPT_IN=1            # monitored test participant consented
EXPECTED_ACTIVE=1
CHECKIN_TIMEOUT_S=15
SENSOR_STALE_S=5
PATIENT_ADDRESS=+1XXXXXXXXXX    # consenting teammate, E.164
CAREGIVER_ADDRESS=+1XXXXXXXXXX  # second consenting teammate
PHOTON_MODE=mock                # mock | api   (Photon 2.0 Beta REST API)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_API_KEY=         # pho_sk_... (needs platforms:write for assignments)
PHOTON_WEBHOOK_SECRET=          # whsec_... returned once when you add the webhook destination
PHOTON_LINE=                    # optional: our iMessage line E.164; else looked up from assignments
LIVE_HAR_VALIDATED=0           # 1 only after ml.check_live passes on the real boards
# --- live sensing: the team's ESPectre boards (WiCare). Comma-separated id=endpoint list
DETECTOR=burst                  # burst = ESPectre score + burst-then-stillness rule (score = old CSI research path)
ESPECTRE_BOARDS=b1=http://172.20.10.3:62587/espectre/v1
BURST_THRESHOLD=0.962           # board score counted as strong movement (calibrated in the room)
BURST_MAX_S=3.0                 # longer bursts are walking, not a fall
BURST_STILL_S=8.0               # stillness needed after the burst

# --- ward demo: which room the teammate controls from /ward/control (the others are simulated)
WARD_ROOMS=1
PATIENT_CHECKINS=0               # 0: nurse only gets the room's 1/2 question (no patient wellbeing check)
WARD_LIVE_ROOM=1
